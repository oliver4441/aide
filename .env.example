# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_URL="https://aide.omixsystems.store"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Admin access — comma-separated Google account emails that get the admin
# role when they sign in with Google
ADMIN_EMAILS="kipkiruigideon890@gmail.com"

# Firebase Authentication (server-side token verification)
# Must match NEXT_PUBLIC_FIREBASE_PROJECT_ID below.
FIREBASE_PROJECT_ID="omix-systems-cd1af"

# Firebase web config (client-side Google sign-in popup)
# Copy these from Firebase Console → Project settings → Your apps → Web app.
# Every domain the app is served from must also be added under
# Firebase Console → Authentication → Settings → Authorized domains,
# otherwise Google sign-in fails with auth/unauthorized-domain.
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_DATABASE_URL="https://your-project-default-rtdb.firebaseio.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-web-app-id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"
