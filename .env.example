# Copy to `.env` and fill in real values. Never commit `.env` itself.

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_URL="https://aide.omixsystems.store"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Admin access — comma-separated emails listed here are matched against the
# Admin table and granted the admin role. Everyone else signs in against the
# User table with `user` role.
#
# Set this explicitly. `src/lib/auth.ts` and `src/lib/mobileAuth.ts` fall back
# to a hardcoded address when it is unset, which means an unset ADMIN_EMAILS
# silently grants admin to whoever that address belongs to. Until that fallback
# is removed, always set this variable.
ADMIN_EMAILS="you@example.com"

# Seed credentials, required only by `prisma/seed.ts`.
#
# These were previously hardcoded in `prisma/seed.ts`, and the resulting
# passwords were published in `public/llms.txt` before commit `90041d6` — treat
# them as compromised and pick new, random ones.
#
# ⚠️ The seed DELETES all reviews, sync conflicts, sales, sale items, products,
# categories, memberships and businesses before it inserts. Development only.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="generate-a-random-password"
SEED_USER_EMAIL="you@example.com"
SEED_USER_PASSWORD="generate-a-random-password"
SEED_USER_NAME="Your Name"
