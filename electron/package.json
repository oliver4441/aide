{
  "name": "aide-electron",
  "productName": "Aide",
  "private": true,
  "version": "1.0.0",
  "description": "Aide - Offline-first Business Management Platform",
  "main": "build/main.js",
  "scripts": {
    "build": "tsc",
    "start": "electron .",
    "pack": "npm run build && capacitor-electron vendor && electron-builder --config electron-builder.config.js",
    "build:win": "npm run pack -- --win --x64",
    "build:mac": "npm run pack -- --mac --x64 --arm64",
    "build:linux": "npm run pack -- --linux --x64 --arm64"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.5.0"
  }
}