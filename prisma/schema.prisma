generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Platform admin
model Admin {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          AdminRole @default(SUPER_ADMIN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  businesses    Business[]
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
}

// Business owner
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  businesses    BusinessMembership[]
  notifications Notification[]
  notificationPrefs NotificationPreference[]

  // AIDE-03: RBAC
  employeeProfile Employee?
  sentInvitations Invitation[] @relation("Inviter")
  
  // AIDE-11: POS advanced
  shifts CashierShift[] @relation("ShiftCashier")

  // AIDE-12: approval workflows
  requestedApprovals ApprovalRequest[] @relation("ApprovalRequester")
  approvalDecisions  ApprovalDecision[] @relation("ApprovalActor")
  delegationsFrom    ApprovalDelegation[] @relation("DelegationFrom")
  delegationsTo      ApprovalDelegation[] @relation("DelegationTo")
  // AIDE-19 / AIDE-03: immutable audit trail
  auditEvents AuditEvent[]
}

// A business (shop, salon, store, etc.)
model Business {
  id            String    @id @default(cuid())
  name          String
  type          BusinessType
  slug          String    @unique
  currency      String    @default("KSh")
  taxRate       Decimal   @default(0) @db.Decimal(19, 4)
  receiptFooter String?
  logoUrl       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  admin         Admin?    @relation(fields: [adminId], references: [id])
  adminId       String?

  memberships   BusinessMembership[]
  products      Product[]
  sales         Sale[]
  categories    Category[]
  reviews       Review[]
  notifications Notification[]
  notificationPrefs NotificationPreference[]

  // AIDE-12: approval workflows
  approvalPolicies   ApprovalPolicy[]
  approvalGroups     ApprovalGroup[]
  approvalDelegations ApprovalDelegation[]
  approvalRequests   ApprovalRequest[]

  // Top-level tenant (legal entity / company). A Business is the operational
  // unit (branch / store) that belongs to an Organization. Required: every
  // Business is linked to exactly one Organization. Legacy rows are backfilled
  // and the column tightened to NOT NULL by prisma/org-backfill.sql (see
  // docs/architecture/org-hierarchy.md).
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationId String

  // Inverse sides for optional branch→Business relations (AIDE-02).
  warehouses  Warehouse[]
  terminals   Terminal[]
  cashDrawers CashDrawer[]

  // Double-entry accounting (AIDE-05)
  accounts          Account[]
  journalEntries    JournalEntry[]
  accountingPeriods AccountingPeriod[]

  // AIDE-03: RBAC
  employees     Employee[]
  invitations   Invitation[]

  // AIDE-08: Customers & Accounts Receivable
  customers     Customer[]
  invoices      Invoice[]
  payments      PaymentAllocation[]

  // AIDE-09: Suppliers & Accounts Payable
  suppliers         Supplier[]
  purchaseOrders    PurchaseOrder[]
  goodsReceived     GoodsReceivedNote[]
  supplierInvoices  SupplierInvoice[]
  supplierPayments  SupplierPayment[]
  
  // AIDE-10: Inventory advanced
  stockAdjustments  StockAdjustment[]

  // AIDE-11: POS advanced
  refunds           Refund[]
  splitPayments     SplitPayment[]
  shifts            CashierShift[]

  // AIDE-22: Data import
  importBatches     ImportBatch[]

  // AIDE-07 / ACC-11: fixed asset register
  fixedAssets       FixedAsset[]
  // AIDE-19 / AIDE-03: immutable audit trail
  auditEvents       AuditEvent[]

  @@index([organizationId])
}

// Legal entity / company that owns one or more businesses (branches / stores)
// and the location dimensions below. Introduced by AIDE-02.
model Organization {
  id            String    @id @default(cuid())
  name          String
  legalName     String?
  slug          String    @unique
  taxId         String?
  baseCurrency  String    @default("KES")
  status        OrgStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  businesses      Business[]
  departments     Department[]
  warehouses      Warehouse[]
  stockLocations  StockLocation[]
  terminals       Terminal[]
  cashDrawers     CashDrawer[]

  // AIDE-19 / AIDE-03: immutable audit trail
  auditEvents     AuditEvent[]

  // AIDE-ADMIN: OMIX platform subscription billing (not merchant billing)
  billingEmail        String?
  platformSubscription PlatformSubscription?
  platformInvoices     PlatformInvoice[]
  platformEvents       PlatformWebhookEvent[]
  platformNotes        PlatformSupportNote[]
}

enum OrgStatus {
  ACTIVE
  ARCHIVED
}

// Org sub-unit used for cost centres and responsibility boundaries.
model Department {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  code           String?
  costCentre     String?
  parent         Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  parentId       String?
  children       Department[] @relation("DepartmentHierarchy")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([parentId])
}

enum WarehouseType {
  WAREHOUSE
  STOCK_ROOM
}

// A warehouse or stock room. Optionally tied to a branch (Business).
model Warehouse {
  id             String        @id @default(cuid())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  branch         Business?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  branchId       String?
  name           String
  code           String?
  type           WarehouseType @default(WAREHOUSE)
  address        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  stockLocations StockLocation[]
  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([branchId])
}

// A bin / shelf / zone inside a warehouse.
model StockLocation {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  warehouseId    String
  name           String
  code           String?
  zone           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  terminals      Terminal[]
  @@unique([warehouseId, code])
  @@index([organizationId])
  @@index([warehouseId])
}

// A POS terminal / checkout lane. Optional branch + stock-location association.
model Terminal {
  id             String         @id @default(cuid())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  branch         Business?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  branchId       String?
  location       StockLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  locationId     String?
  name           String
  code           String?
  active         Boolean        @default(true)
  openedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  cashDrawers    CashDrawer[]
  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([branchId])
  @@index([locationId])
}

enum CashDrawerStatus {
  CLOSED
  OPEN
}

// A physical cash drawer, optionally assigned to a terminal / branch.
model CashDrawer {
  id             String           @id @default(cuid())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  branch         Business?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  branchId       String?
  terminal       Terminal?       @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  terminalId     String?
  name           String
  code           String?
  status         CashDrawerStatus @default(CLOSED)
  openedAt       DateTime?
  openedBy       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([branchId])
  @@index([terminalId])
}

enum BusinessType {
  SALON
  SHOP
  RESTAURANT
  GROCERY
  PHARMACY
  ELECTRONICS
  CLOTHING
  OTHER
}

// User-Business relationship
model BusinessMembership {
  id        String   @id @default(cuid())
  role      BusinessRole @default(MANAGER)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  userId    String
  business  Business @relation(fields: [businessId], references: [id])
  businessId String

  employee  Employee?

  @@unique([userId, businessId])
}

enum BusinessRole {
  OWNER
  MANAGER
  STAFF
}

// Product categories
model Category {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  business  Business @relation(fields: [businessId], references: [id])
  businessId String
  products  Product[]

  @@unique([businessId, name])
}

// Inventory items
model Product {
  id            String   @id @default(cuid())
  name          String
  sku           String?
  buyingPrice   Decimal  @db.Decimal(19, 4)
  sellingPrice  Decimal  @db.Decimal(19, 4)
  quantity      Int      @default(0)
  lowStock      Int      @default(5)
  isService     Boolean  @default(false)
  imageUrl      String?
  thumbnailUrl  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id])
  businessId    String
  category      Category? @relation(fields: [categoryId], references: [id])
  categoryId    String?

  saleItems     SaleItem[]
  
  // AIDE-10: Inventory advanced
  stockAdjustmentLines StockAdjustmentLine[]
}

// Sales transactions
model Sale {
  id            String   @id @default(cuid())
  total         Decimal  @db.Decimal(19, 4)
  cost          Decimal  @db.Decimal(19, 4)
  profit        Decimal  @db.Decimal(19, 4)
  paid          Decimal  @db.Decimal(19, 4)
  change        Decimal  @db.Decimal(19, 4)
  tax           Decimal  @default(0) @db.Decimal(19, 4)
  taxRate       Decimal  @default(0) @db.Decimal(19, 4)
  cashier       String?
  paymentMethod PaymentMethod @default(CASH)
  notes         String?
  createdAt     DateTime @default(now())

  business      Business @relation(fields: [businessId], references: [id])
  businessId    String
  items         SaleItem[]

  // AIDE-08: Credit sales — link to customer for credit tracking
  customer      Customer? @relation(fields: [customerId], references: [id])
  customerId    String?

  // AIDE-11: POS advanced
  refunds       Refund[]
  splitPayments SplitPayment[]
  shift         CashierShift?   @relation("SaleShift", fields: [shiftId], references: [id])
  shiftId       String?
  tipAmount     Decimal       @default(0) @db.Decimal(19, 4)
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  OTHER
}

// Individual sale items
model SaleItem {
  id        String @id @default(cuid())
  name      String
  quantity  Int
  price     Decimal  @db.Decimal(19, 4)
  cost      Decimal  @db.Decimal(19, 4)

  sale      Sale   @relation(fields: [saleId], references: [id])
  saleId    String
  product   Product? @relation(fields: [productId], references: [id])
  productId String?
}

// User reviews/feedback
model Review {
  id            String   @id @default(cuid())
  rating        Int
  categories    Json
  comment       String?
  contactEmail  String?
  businessId    String
  userId        String?
  createdAt     DateTime @default(now())

  business      Business @relation(fields: [businessId], references: [id])
}

// Offline sync conflict tracking
model SyncConflict {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String
  clientData    Json
  serverData    Json
  resolution    String?
  status        String   @default("PENDING_OWNER")
  businessId    String
  createdAt     DateTime @default(now())
  resolvedAt    DateTime?
}

// In-app notification center (server side).
model Notification {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId  String
  type        String // sales | inventory | customers | system | business
  channel     String    @default("server")
  title       String
  message     String
  data        Json?
  read        Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  @@index([userId, businessId, createdAt])
  @@index([userId, read])
}

// Per-user, per-business notification category preferences.
model NotificationPreference {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  type       String // sales | inventory | customers | system | business
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([userId, businessId, type])
}

// =====================================================================// AIDE-05: Double-entry accounting
// =====================================================================
/// Account types in the chart of accounts
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

/// Sub-type for more granular reporting (e.g. CurrentAsset, FixedAsset)
enum AccountSubType {
  /// -- Assets --
  CURRENT_ASSET
  FIXED_ASSET
  ACCOUNTS_RECEIVABLE
  /// -- Liabilities --
  CURRENT_LIABILITY
  LONG_TERM_LIABILITY
  ACCOUNTS_PAYABLE
  /// -- Equity --
  OWNER_EQUITY
  RETAINED_EARNINGS
  /// -- Income --
  SALES_REVENUE
  SERVICE_REVENUE
  OTHER_INCOME
  /// -- Expense --
  COST_OF_GOODS_SOLD
  OPERATING_EXPENSE
  SALARIES_EXPENSE
  UTILITIES_EXPENSE
  RENT_EXPENSE
  DEPRECIATION_EXPENSE
  OTHER_EXPENSE
}

/// A single account in the chart of accounts (ACC-01)
model Account {
  id            String          @id @default(cuid())
  code          String          // e.g. "1000", "4001"
  name          String
  type          AccountType
  subType       AccountSubType  @default(OTHER_EXPENSE)
  description   String?
  currency      String          @default("KES")
  isActive      Boolean         @default(true)
  isSystem      Boolean         @default(false) // system accounts cannot be deleted
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId    String

  journalDebits JournalLine[]   @relation("DebitAccount")
  journalCredits JournalLine[]  @relation("CreditAccount")

  @@unique([businessId, code])
  @@index([businessId])
  @@index([type])
}

/// A journal entry (transaction) — the header (ACC-02)
model JournalEntry {
  id            String          @id @default(cuid())
  entryNumber   String          // e.g. "JE-000001"
  date          DateTime        @default(now())
  description   String
  sourceType    String          // sale | purchase | adjustment | opening | expense
  sourceId      String?         // ID of the source record (e.g. Sale.id)
  status        JournalStatus   @default(POSTED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId    String

  lines         JournalLine[]

  @@unique([businessId, entryNumber])
  @@index([businessId])
  @@index([date])
  @@index([sourceType, sourceId])
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

/// Individual debit/credit lines within a journal entry (ACC-02)
model JournalLine {
  id            String          @id @default(cuid())
  lineOrder     Int             // 1-based order within entry
  description   String?
  debit         Decimal         @db.Decimal(19, 4)
  credit        Decimal         @db.Decimal(19, 4)

  entry         JournalEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId       String

  debitAccount  Account?        @relation("DebitAccount", fields: [debitAccountId], references: [id])
  debitAccountId String?

  creditAccount Account?        @relation("CreditAccount", fields: [creditAccountId], references: [id])
  creditAccountId String?

  @@index([entryId])
  @@index([debitAccountId])
  @@index([creditAccountId])
}

/// Accounting periods for period controls (ACC-08 precursor)
model AccountingPeriod {
  id            String            @id @default(cuid())
  year          Int
  month         Int               // 1-12
  label         String            // e.g. "January 2026"
  status        PeriodStatus      @default(OPEN)
  closedAt      DateTime?
  closedBy      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId    String

  @@unique([businessId, year, month])
  @@index([businessId])
}

enum PeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

// =====================================================================// AIDE-08: Customers & Accounts Receivable
// =====================================================================
/// A customer of the business — can hold credit balance and receive invoices
model Customer {
  id            String            @id @default(cuid())
  customerCode  String            // e.g. "CUST-001" (display code)
  name          String
  email         String?
  phone         String?
  address       String?
  city          String?
  notes         String?
  creditLimit   Decimal           @default(0) @db.Decimal(19, 4)
  balance       Decimal           @default(0) @db.Decimal(19, 4) // positive = owes money
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId    String

  invoices      Invoice[]
  payments      PaymentAllocation[]
  creditSales   Sale[]            // sales on credit linked to this customer

  @@unique([businessId, customerCode])
  @@index([businessId])
  @@index([name])
}

/// An invoice generated for a customer (can be from a sale or standalone)
model Invoice {
  id            String            @id @default(cuid())
  invoiceNumber String            // e.g. "INV-2026-0001"
  issueDate     DateTime          @default(now())
  dueDate       DateTime
  status        InvoiceStatus     @default(DRAFT)
  subtotal      Decimal           @db.Decimal(19, 4)
  tax           Decimal           @default(0) @db.Decimal(19, 4)
  total         Decimal           @db.Decimal(19, 4)
  amountPaid    Decimal           @default(0) @db.Decimal(19, 4)
  balanceDue    Decimal           @db.Decimal(19, 4)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId    String

  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String

  lines         InvoiceLine[]
  payments      PaymentAllocation[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

/// Individual line items on an invoice
model InvoiceLine {
  id            String          @id @default(cuid())
  description   String
  quantity      Decimal         @default(1) @db.Decimal(19, 4)
  unitPrice     Decimal         @db.Decimal(19, 4)
  amount        Decimal         @db.Decimal(19, 4) // qty * unitPrice

  invoice       Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId     String

  @@index([invoiceId])
}

/// A payment applied against an invoice or customer balance
model PaymentAllocation {
  id            String            @id @default(cuid())
  amount        Decimal           @db.Decimal(19, 4)
  paymentMethod PaymentMethod     @default(CASH)
  reference     String?           // e.g. M-Pesa transaction code
  notes         String?
  paidAt        DateTime          @default(now())

  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId    String

  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String

  invoice       Invoice?          @relation(fields: [invoiceId], references: [id])
  invoiceId     String?

  @@index([businessId])
  @@index([customerId])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  WRITTEN_OFF
}

// =====================================================================// AIDE-09: Suppliers & Accounts Payable
// =====================================================================
/// A supplier/vendor the business purchases from
model Supplier {
  id            String            @id @default(cuid())
  supplierCode  String            // e.g. "SUP-001" (display code)
  name          String
  contactName   String?
  email         String?
  phone         String?
  address       String?
  city          String?
  taxId         String?           // supplier tax/PIN number
  notes         String?
  paymentTerms  Int               @default(30) // days until payment due
  balance       Decimal           @default(0) @db.Decimal(19, 4) // positive = we owe
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId    String

  purchaseOrders    PurchaseOrder[]
  goodsReceived     GoodsReceivedNote[]
  supplierInvoices  SupplierInvoice[]
  payments          SupplierPayment[]

  @@unique([businessId, supplierCode])
  @@index([businessId])
  @@index([name])
}

/// A purchase order sent to a supplier
model PurchaseOrder {
  id            String              @id @default(cuid())
  poNumber      String              // e.g. "PO-2026-0001"
  orderDate     DateTime            @default(now())
  expectedDate  DateTime?
  status        PurchaseOrderStatus @default(DRAFT)
  subtotal      Decimal             @db.Decimal(19, 4)
  tax           Decimal             @default(0) @db.Decimal(19, 4)
  total         Decimal             @db.Decimal(19, 4)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  business      Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId    String

  supplier      Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId    String

  lines              PurchaseOrderLine[]
  goodsReceived      GoodsReceivedNote[]
  supplierInvoices   SupplierInvoice[]

  @@unique([businessId, poNumber])
  @@index([businessId])
  @@index([supplierId])
  @@index([status])
}

/// Individual line items on a purchase order
model PurchaseOrderLine {
  id            String          @id @default(cuid())
  description   String
  quantity      Decimal         @db.Decimal(19, 4)
  unitPrice     Decimal         @db.Decimal(19, 4)
  amount        Decimal         @db.Decimal(19, 4) // qty * unitPrice

  purchaseOrder PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String

  @@index([purchaseOrderId])
}

/// Goods received against a purchase order (GRN)
model GoodsReceivedNote {
  id            String            @id @default(cuid())
  grnNumber     String            // e.g. "GRN-2026-0001"
  receivedDate  DateTime          @default(now())
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId    String

  purchaseOrder PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String

  supplier      Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId    String

  lines         GoodsReceivedLine[]

  @@unique([businessId, grnNumber])
  @@index([businessId])
  @@index([purchaseOrderId])
}

/// Individual line items on a goods received note
model GoodsReceivedLine {
  id            String          @id @default(cuid())
  description   String
  quantity      Decimal         @db.Decimal(19, 4) // qty received
  unitCost      Decimal         @db.Decimal(19, 4) // actual unit cost received
  amount        Decimal         @db.Decimal(19, 4) // qty * unitCost
  productMatch  String?         // optional: product SKU matched during receiving

  grn           GoodsReceivedNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  grnId         String

  @@index([grnId])
}

/// An invoice received from a supplier
model SupplierInvoice {
  id            String                @id @default(cuid())
  invoiceNumber String                // supplier's invoice number
  ourRef        String?               // our internal reference
  issueDate     DateTime              @default(now())
  dueDate       DateTime
  status        SupplierInvoiceStatus @default(PENDING)
  subtotal      Decimal               @db.Decimal(19, 4)
  tax           Decimal               @default(0) @db.Decimal(19, 4)
  total         Decimal               @db.Decimal(19, 4)
  amountPaid    Decimal               @default(0) @db.Decimal(19, 4)
  balanceDue    Decimal               @db.Decimal(19, 4)
  notes         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId    String

  supplier      Supplier              @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId    String

  purchaseOrder PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String?

  payments      SupplierPayment[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([supplierId])
  @@index([status])
  @@index([dueDate])
}

/// A payment made to a supplier
model SupplierPayment {
  id            String            @id @default(cuid())
  amount        Decimal           @db.Decimal(19, 4)
  paymentMethod PaymentMethod     @default(CASH)
  reference     String?           // e.g. bank transfer ref, M-Pesa code
  notes         String?
  paidAt        DateTime          @default(now())

  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId    String

  supplier      Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId    String

  invoice       SupplierInvoice?  @relation(fields: [invoiceId], references: [id])
  invoiceId     String?

  @@index([businessId])
  @@index([supplierId])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SupplierInvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

// =====================================================================// AIDE-10: Inventory Advanced — Stock adjustments, movement ledger, valuation
// =====================================================================
/// Reason for a stock adjustment (INV-11)
enum StockAdjustmentReason {
  COUNT_DIFFERENCE
  DAMAGE
  THEFT
  EXPIRED
  RETURN_TO_SUPPLIER
  CUSTOMER_RETURN
  GIFT_SAMPLE
  WRITE_OFF
  OTHER
}

/// Manual stock adjustment with audit trail (INV-11)
model StockAdjustment {
  id            String                  @id @default(cuid())
  adjustmentNo  String                  // e.g. "SAJ-2026-0001"
  date          DateTime                @default(now())
  reason        StockAdjustmentReason
  notes         String?
  createdAt     DateTime                @default(now())

  business      Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId    String

  lines         StockAdjustmentLine[]

  @@unique([businessId, adjustmentNo])
  @@index([businessId])
  @@index([date])
}

/// Individual product line on a stock adjustment
model StockAdjustmentLine {
  id            String          @id @default(cuid())
  productName   String          // snapshot of product name
  quantityDelta Int             // positive = add stock, negative = remove stock
  unitCost      Decimal         @db.Decimal(19, 4) // cost at time of adjustment

  adjustment    StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  adjustmentId  String

  product       Product?        @relation(fields: [productId], references: [id])
  productId     String?

  @@index([adjustmentId])
  @@index([productId])
}

// =====================================================================// AIDE-03: Tenant-scoped RBAC — Employee management & invitations
// =====================================================================
/// Granular permissions that roles grant
enum Permission {
  // Sales
  SALE_CREATE
  SALE_READ
  SALE_DELETE
  SALE_REFUND
  // Inventory
  PRODUCT_CREATE
  PRODUCT_READ
  PRODUCT_UPDATE
  PRODUCT_DELETE
  // Customers
  CUSTOMER_CREATE
  CUSTOMER_READ
  CUSTOMER_UPDATE
  CUSTOMER_DELETE
  // Suppliers
  SUPPLIER_CREATE
  SUPPLIER_READ
  SUPPLIER_UPDATE
  SUPPLIER_DELETE
  // Purchasing
  PURCHASE_ORDER_CREATE
  PURCHASE_ORDER_READ
  PURCHASE_ORDER_UPDATE
  GOODS_RECEIVE
  // Supplier invoices
  SUPPLIER_INVOICE_CREATE
  SUPPLIER_INVOICE_READ
  SUPPLIER_INVOICE_UPDATE
  // Supplier payments
  SUPPLIER_PAYMENT_CREATE
  SUPPLIER_PAYMENT_READ
  // Accounting
  ACCOUNT_READ
  ACCOUNT_EDIT
  JOURNAL_CREATE
  JOURNAL_READ
  // Reports
  REPORT_READ
  REPORT_EXPORT
  // Settings
  SETTINGS_READ
  SETTINGS_UPDATE
  // Employee management
  EMPLOYEE_INVITE
  EMPLOYEE_MANAGE
  // Shifts & drawers
  SHIFT_MANAGE
  // AIDE-10: Stock adjustments
  STOCK_ADJUST_CREATE
  STOCK_ADJUST_READ
  // AIDE-11: POS advanced
  SHIFT_OPEN
  SHIFT_CLOSE
  REFUND_CREATE
  REFUND_READ
}

/// An employee profile — extends User + BusinessMembership with display info
/// and permission overrides.
model Employee {
  id            String          @id @default(cuid())
  employeeId    String          // e.g. "EMP-001" (display ID)
  phone         String?
  avatarUrl     String?
  isActive      Boolean         @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String          @unique

  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId    String

  membership    BusinessMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  membershipId  String          @unique

  @@unique([userId, businessId])
  @@unique([businessId, employeeId])
  @@index([businessId])
}

/// Pending invitation to join a business. Generated by OWNER/MANAGER,
/// accepted by the invitee via email link.
model Invitation {
  id            String            @id @default(cuid())
  token         String            @unique // URL-safe random token
  email         String
  role          BusinessRole      @default(STAFF)
  expiresAt     DateTime
  acceptedAt    DateTime?
  acceptedBy    String?           // User.id of the acceptor
  createdAt     DateTime          @default(now())

  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId    String

  invitedBy     User              @relation("Inviter", fields: [invitedById], references: [id])
  invitedById   String

  @@index([businessId])
  @@index([token])
  @@index([email])
}

// =====================================================================// AIDE-11: POS Advanced — Refunds, shifts, split payment, tips
// =====================================================================
/// Reason for a refund (POS-10)
enum RefundReason {
  CUSTOMER_REQUEST
  WRONG_ITEM
  WRONG_QUANTITY
  DAMAGED_PRODUCT
  DOUBLE_CHARGE
  OTHER
}

/// Status of a refund (POS-10)
enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

/// Cashier shift tracking (POS-13)
enum ShiftStatus {
  OPEN
  CLOSED
  LOCKED
}

/// Refund of a previous sale (POS-10)
model Refund {
  id            String            @id @default(cuid())
  refundNo      String            // e.g. "RFD-2026-0001"
  reason        RefundReason
  status        RefundStatus      @default(PENDING)
  refundedTotal Decimal           @db.Decimal(19, 4)
  refundedTax   Decimal           @default(0) @db.Decimal(19, 4)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  sale          Sale              @relation(fields: [saleId], references: [id])
  saleId        String

  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId    String

  lines         RefundLine[]

  @@unique([businessId, refundNo])
  @@index([businessId])
  @@index([saleId])
}

/// Individual line on a refund
model RefundLine {
  id        String   @id @default(cuid())
  name      String   // snapshot of product name
  quantity  Int      // quantity refunded
  price     Decimal  @db.Decimal(19, 4) // price at time of refund
  cost      Decimal  @db.Decimal(19, 4) // cost at time of refund

  refund    Refund   @relation(fields: [refundId], references: [id], onDelete: Cascade)
  refundId  String


  @@index([refundId])
}

/// Cashier shift — tracks cash drawer opening/closing (POS-13)
model CashierShift {
  id            String            @id @default(cuid())
  shiftNo       String            // e.g. "SH-2026-0001"
  status        ShiftStatus       @default(OPEN)
  openedAt      DateTime          @default(now())
  closedAt      DateTime?
  openingCash   Decimal           @default(0) @db.Decimal(19, 4)
  closingCash   Decimal?
  expectedCash  Decimal?
  cashDifference Decimal?         @db.Decimal(19, 4)
  totalSales    Decimal           @default(0) @db.Decimal(19, 4)
  totalRefunds  Decimal           @default(0) @db.Decimal(19, 4)
  totalTips     Decimal           @default(0) @db.Decimal(19, 4)
  cashCount     Decimal?
  notes         String?
  createdAt     DateTime          @default(now())

  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId    String

  cashier       User              @relation("ShiftCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  cashierId     String

  sales         Sale[]            @relation("SaleShift")

  @@map("CashierShift")

  @@unique([businessId, shiftNo])
  @@index([businessId])
  @@index([cashierId])
  @@index([openedAt])
}

/// Split payment — one sale, multiple payment methods (POS-18)
model SplitPayment {
  id            String            @id @default(cuid())
  amount        Decimal           @db.Decimal(19, 4)
  paymentMethod PaymentMethod
  notes         String?
  createdAt     DateTime          @default(now())

  sale          Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId        String

  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId    String

  @@index([saleId])
  @@index([businessId])
}

// ---- AIDE-12: approval workflows and separation of duties ----

enum ApprovalActionType {
  STOCK_ADJUSTMENT
  PURCHASE_ORDER
  SUPPLIER_PAYMENT
  REFUND
  JOURNAL
  PRICE_CHANGE
  DISCOUNT
  EXPENSE
  PERIOD_CLOSE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalDecisionType {
  APPROVE
  REJECT
}

/// A versioned approval rule. Historical requests snapshot the version they
/// were created under, so editing or superseding a policy never rewrites them.
model ApprovalPolicy {
  id                  String              @id @default(cuid())
  businessId          String
  business            Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                String
  actionType          ApprovalActionType
  /// Null means the policy applies to every amount for this action.
  threshold           Decimal?            @db.Decimal(19, 4)
  minApprovals        Int                 @default(1)
  requireSeparation   Boolean             @default(true)
  escalationHours     Int?
  escalationGroup     ApprovalGroup?      @relation("EscalationGroup", fields: [escalationGroupId], references: [id], onDelete: SetNull)
  escalationGroupId   String?
  approverGroup       ApprovalGroup?      @relation("ApproverGroup", fields: [approverGroupId], references: [id], onDelete: SetNull)
  approverGroupId     String?
  version             Int                 @default(1)
  active              Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([businessId, actionType, version])
  @@index([businessId, actionType])
}

model ApprovalGroup {
  id          String                 @id @default(cuid())
  businessId  String
  business    Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  members     ApprovalGroupMember[]
  escalatedPolicies ApprovalPolicy[] @relation("EscalationGroup")
  policies          ApprovalPolicy[] @relation("ApproverGroup")

  @@unique([businessId, name])
  @@index([businessId])
}

model ApprovalGroupMember {
  id        String        @id @default(cuid())
  groupId   String
  group     ApprovalGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime      @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

/// Time-boxed delegation: `toUser` may decide on behalf of `fromUser`
/// while active and before expiresAt.
model ApprovalDelegation {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fromUser    User     @relation("DelegationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  fromUserId  String
  toUser      User     @relation("DelegationTo", fields: [toUserId], references: [id], onDelete: Cascade)
  toUserId    String
  expiresAt   DateTime
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([businessId, fromUserId])
  @@index([businessId, toUserId])
}

model ApprovalRequest {
  id                String                @id @default(cuid())
  businessId        String
  business          Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actionType        ApprovalActionType
  resourceType      String
  resourceId        String?
  amount            Decimal?              @db.Decimal(19, 4)
  payload           Json?
  requester         User                  @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  requesterId       String
  status            ApprovalStatus        @default(PENDING)
  /// Immutable snapshot of the policy used at creation time.
  policyId          String
  policyVersion     Int
  policyName        String
  minApprovals      Int
  requireSeparation Boolean
  approverGroupId   String?
  escalationGroupId String?
  escalationHours   Int?
  activeGroupId     String?
  escalatedAt       DateTime?
  createdAt         DateTime              @default(now())
  resolvedAt        DateTime?
  executedAt        DateTime?
  decisions         ApprovalDecision[]

  @@index([businessId, status])
  @@index([resourceType, resourceId])
}

model ApprovalDecision {
  id            String                @id @default(cuid())
  request       ApprovalRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId     String
  actor         User                  @relation("ApprovalActor", fields: [actorId], references: [id], onDelete: Restrict)
  actorId       String
  decision      ApprovalDecisionType
  comments      String?
  policyVersion Int
  decidedAt     DateTime              @default(now())

  @@unique([requestId, actorId])
  @@index([requestId])
}


// AIDE-22: auditable record of one data-import run. Rollback support:
// createdIds holds the ids of records created by this batch so an undo can
// delete exactly what the import created (scoped to businessId). For rows
// merged into existing records, updatedSnapshot stores the prior values of
// exactly the fields the import overwrote, so an undo can restore them.
model ImportBatch {
  id                String                  @id @default(cuid())
  fileName          String
  entity            ImportEntity
  status            ImportBatchStatus       @default(COMPLETED)
  duplicateStrategy ImportDuplicateStrategy @default(SKIP)
  mapping           Json?
  totalRows         Int
  createdCount      Int                     @default(0)
  updatedCount      Int                     @default(0)
  skippedCount      Int                     @default(0)
  failedCount       Int                     @default(0)
  createdIds        Json?                   // { products?: string[], customers?: string[], categoryIds?: string[] }
  updatedSnapshot   Json?                   // [{ id, entity, prior: { ...overwrittenFields } }]
  errorReport       Json?                   // [{ row, errors: string[] }]
  createdById       String?
  createdAt         DateTime                @default(now())
  rolledBackAt      DateTime?

  business          Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId        String

  @@index([businessId, createdAt])
}

enum ImportEntity {
  PRODUCTS
  CUSTOMERS
  SALES
}

enum ImportBatchStatus {
  COMPLETED
  ROLLED_BACK
}

enum ImportDuplicateStrategy {
  SKIP
  MERGE
}

// =====================================================================// AIDE-07 / ACC-11: Fixed assets & depreciation
// =====================================================================
enum DepreciationMethod {
  STRAIGHT_LINE
}

enum FixedAssetStatus {
  ACTIVE
  DISPOSED
}

/// A capitalised fixed asset with a straight-line depreciation schedule.
model FixedAsset {
  id               String             @id @default(cuid())
  assetCode        String             // e.g. "FA-0001"
  name             String
  category         String?
  description      String?
  acquisitionDate  DateTime
  cost             Decimal            @db.Decimal(19, 4)
  salvageValue     Decimal            @default(0) @db.Decimal(19, 4)
  usefulLifeMonths Int
  method           DepreciationMethod @default(STRAIGHT_LINE)
  status           FixedAssetStatus   @default(ACTIVE)
  disposedAt       DateTime?
  disposalProceeds Decimal?           @db.Decimal(19, 4)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  business         Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId       String

  depreciation     DepreciationEntry[]

  @@unique([businessId, assetCode])
  @@index([businessId])
  @@index([businessId, status])
}

/// One month of depreciation for an asset; unique per asset and period.
model DepreciationEntry {
  id             String      @id @default(cuid())
  periodYear     Int
  periodMonth    Int         // 1-12
  amount         Decimal     @db.Decimal(19, 4)
  accumulated    Decimal     @db.Decimal(19, 4) // accumulated after this entry
  journalEntryId String?
  createdAt      DateTime    @default(now())

  asset          FixedAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId        String

  @@unique([assetId, periodYear, periodMonth])
  @@index([assetId])
  @@index([periodYear, periodMonth])
}

/// AIDE-19 / AIDE-03: application-level immutable audit trail.
///
/// Written for privileged and financial actions (membership, role and
/// permission changes today; posting/approval events as later slices land).
/// Rows are append-only: no update/delete endpoint exists and the API never
/// mutates them. `businessId`/`organizationId`/`actorId` are nullable and
/// `onDelete: SetNull` so the trail survives removal of the referenced record.
model AuditEvent {
  id             String   @id @default(cuid())
  action         String
  entityType     String
  entityId       String?
  summary        String?
  metadata       Json?
  createdAt      DateTime @default(now())

  actor          User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId        String?
  business       Business?     @relation(fields: [businessId], references: [id], onDelete: SetNull)
  businessId     String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationId String?

  @@index([businessId, createdAt])
  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

// =====================================================================
// AIDE-ADMIN: OMIX platform subscription and billing domain.
//
// This is the *platform* side of the business: what an organization pays
// OMIX for Aide. It is deliberately separate from the merchant accounting
// models above (Sale, Invoice, PaymentAllocation), which record what a
// business's own customers pay that business. The two must never be summed
// together or labelled interchangeably.
// =====================================================================

/// Billing cadence for a platform plan version.
enum PlatformBillingInterval {
  MONTHLY
  YEARLY
}

/// Lifecycle of a plan version. Only PUBLISHED versions may be subscribed to.
enum PlatformPlanVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Subscription states the console must distinguish.
enum PlatformSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  CANCELED
  EXPIRED
}

enum PlatformInvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum PlatformPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PlatformWebhookEventStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

/// A plan family (Starter, Professional, Enterprise). Commercial values live
/// on versions, never here, so editing a plan cannot silently rewrite history.
model PlatformPlan {
  id          String   @id @default(cuid())
  key         String   @unique // starter | professional | enterprise
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions      PlatformPlanVersion[]
  subscriptions PlatformSubscription[]
}

/// One immutable, dated version of a plan. Publishing creates a new row; the
/// version already attached to a subscription is never mutated.
model PlatformPlanVersion {
  id            String                    @id @default(cuid())
  plan          PlatformPlan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId        String
  version       Int
  status        PlatformPlanVersionStatus @default(DRAFT)
  displayName   String
  description   String?
  price         Decimal                   @default(0) @db.Decimal(19, 4)
  currency      String                    @default("KES")
  interval      PlatformBillingInterval   @default(MONTHLY)
  trialDays     Int                       @default(0)
  /// Feature switches, e.g. { "pos": true, "reports": true }.
  entitlements  Json?
  /// Quantitative limits, e.g. { "branches": 1, "members": 5 }. null = unlimited.
  limits        Json?
  effectiveFrom DateTime                  @default(now())
  publishedAt   DateTime?
  archivedAt    DateTime?
  createdBy     String?
  changeReason  String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  subscriptions PlatformSubscription[]

  @@unique([planId, version])
  @@index([planId, status])
}

/// An organization's current platform subscription. `status` mirrors the
/// provider; a local administrative exception lives in `localOverrideNote`
/// and never overwrites the provider state silently.
model PlatformSubscription {
  id                     String                     @id @default(cuid())
  organization           Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId         String                     @unique
  plan                   PlatformPlan               @relation(fields: [planId], references: [id])
  planId                 String
  planVersion            PlatformPlanVersion        @relation(fields: [planVersionId], references: [id])
  planVersionId          String
  status                 PlatformSubscriptionStatus @default(TRIALING)
  provider               String                     @default("stripe")
  providerSubscriptionId String?                    @unique
  amount                 Decimal                    @default(0) @db.Decimal(19, 4)
  currency               String                     @default("KES")
  interval               PlatformBillingInterval    @default(MONTHLY)
  trialStart             DateTime?
  trialEnd               DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean                    @default(false)
  canceledAt             DateTime?
  endedAt                DateTime?
  localOverrideNote      String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  invoices PlatformInvoice[]
  events   PlatformWebhookEvent[]
  notes    PlatformSupportNote[]

  @@index([status])
  @@index([currentPeriodEnd])
  @@index([planId])
}

/// An OMIX-issued subscription invoice. Read-only in the console.
model PlatformInvoice {
  id                String                @id @default(cuid())
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId    String
  subscription      PlatformSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionId    String?
  number            String                @unique
  providerInvoiceId String?               @unique
  status            PlatformInvoiceStatus @default(OPEN)
  amount            Decimal               @db.Decimal(19, 4)
  amountPaid        Decimal               @default(0) @db.Decimal(19, 4)
  currency          String                @default("KES")
  issuedAt          DateTime              @default(now())
  dueAt             DateTime?
  paidAt            DateTime?
  hostedUrl         String?
  createdAt         DateTime              @default(now())

  payments PlatformPayment[]
  events   PlatformWebhookEvent[]
  notes    PlatformSupportNote[]

  @@index([organizationId])
  @@index([status])
  @@index([issuedAt])
}

/// A single payment attempt against an invoice. Failure detail is sanitized
/// before it is stored, so no card data or provider secret can reach the UI.
model PlatformPayment {
  id                String                @id @default(cuid())
  invoice           PlatformInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId         String
  providerPaymentId String?               @unique
  status            PlatformPaymentStatus @default(PENDING)
  amount            Decimal               @db.Decimal(19, 4)
  currency          String                @default("KES")
  failureCode       String?
  failureMessage    String?
  attemptedAt       DateTime              @default(now())
  createdAt         DateTime              @default(now())

  @@index([invoiceId])
  @@index([status])
  @@index([attemptedAt])
}

/// Provider webhook deliveries and their processing state. `payloadSummary`
/// holds a redacted projection only; the raw payload never reaches the client.
model PlatformWebhookEvent {
  id             String                     @id @default(cuid())
  providerEventId String                   @unique
  type           String
  status         PlatformWebhookEventStatus @default(PENDING)
  attempts       Int                        @default(0)
  receivedAt     DateTime                   @default(now())
  processedAt    DateTime?
  lastError      String?
  correlationId  String?
  organization   Organization?              @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationId String?
  subscription   PlatformSubscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionId String?
  invoice        PlatformInvoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId      String?
  payloadSummary Json?
  createdAt      DateTime                   @default(now())

  @@index([status, receivedAt])
  @@index([type])
  @@index([organizationId])
}

/// Append-only platform administration audit trail. Separate from AuditEvent
/// because the actor is a platform Admin, not a business User.
model PlatformAuditEvent {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  actorRole  String
  action     String
  entityType String
  entityId   String?
  reason     String?
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

/// Support notes recorded by platform staff against an organization,
/// subscription or invoice.
model PlatformSupportNote {
  id             String                @id @default(cuid())
  organization   Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?
  subscription   PlatformSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId String?
  invoice        PlatformInvoice?      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId      String?
  body           String
  authorId       String
  authorEmail    String
  createdAt      DateTime              @default(now())

  @@index([organizationId, createdAt])
  @@index([subscriptionId, createdAt])
}
