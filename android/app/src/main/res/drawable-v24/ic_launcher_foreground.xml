<?xml version="1.0" encoding="utf-8"?>
<!-- Aide brand logo. The Aide logo is a light-blue (#4DA8FF) stylised
     capacitor/letter symbol: three parallel diagonal strokes crossed by two
     perpendicular bars. We render it as a flat, geometric mark so it stays
     crisp at every density. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Background (light, for the adaptive-icon foreground) -->
    <path
        android:fillColor="#0F172A"
        android:pathData="M0,0h108v108h-108z" />

    <!-- The Aide mark -->
    <group
        android:scaleX="1.35"
        android:scaleY="1.35"
        android:translateX="24"
        android:translateY="12">

        <!-- Three parallel diagonal strokes -->
        <path
            android:fillColor="#4DA8FF"
            android:pathData="M18,30 L48,66 L60,84" />
        <path
            android:fillColor="#4DA8FF"
            android:pathData="M42,18 L66,48 L78,66" />
        <path
            android:fillColor="#4DA8FF"
            android:pathData="M66,6 L84,30 L90,42" />

        <!-- Two perpendicular bars crossing the strokes -->
        <rect
            android:height="14dp"
            android:width="10dp"
            android:fillColor="#4DA8FF"
            android:x="24dp"
            android:y="42dp" />
        <rect
            android:height="14dp"
            android:width="10dp"
            android:fillColor="#4DA8FF"
            android:x="48dp"
            android:y="18dp" />
        <rect
            android:height="14dp"
            android:width="10dp"
            android:fillColor="#4DA8FF"
            android:x="72dp"
            android:y="36dp" />
    </group>

    <!-- A small "Aide" dot below the mark -->
    <path
        android:fillColor="#4DA8FF"
        android:pathData="M49,94 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 z" />
</vector>
