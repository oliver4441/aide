<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar notification icon. A flat, monochrome silhouette so Android's
     runtime tint renders it cleanly. The Aide mark is kept simple at small
     sizes: three diagonal strokes with two crossing bars. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#4DA8FF">

    <!-- diagonal strokes -->
    <path
        android:fillColor="#4DA8FF"
        android:pathData="M2,16 L8,22 L12,22" />
    <path
        android:fillColor="#4DA8FF"
        android:pathData="M6,12 L12,18 L15,18" />
    <path
        android:fillColor="#4DA8FF"
        android:pathData="M10,8 L15,14 L17,14" />

    <!-- crossing bars -->
    <rect
        android:height="6"
        android:width="5"
        android:fillColor="#4DA8FF"
        android:x="4"
        android:y="14" />
    <rect
        android:height="6"
        android:width="5"
        android:fillColor="#4DA8FF"
        android:x="10"
        android:y="8" />
</vector>
