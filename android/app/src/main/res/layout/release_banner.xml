<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0F172A"
    android:orientation="vertical"
    android:padding="16dp"
    android:visibility="gone">

    <!-- Aide brand mark -->
    <com.omix.aide.ui.components.BrandedLogo
        android:id="@+id/release_banner_logo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/release_banner_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Aide 1.0.2 is ready"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/release_banner_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="New release available. You're on Aide 1.0.2; the latest is Aide 1.0.3 — what's new? Open the release page?"
        android:textColor="#94A3B8"
        android:textSize="14sp" />

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/release_banner_open"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_primary"
            android:text="Open release"
            android:textColor="#0F172A"
            android:textSize="14sp" />

        <Button
            android:id="@+id/release_banner_dismiss"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="#334155"
            android:text="Maybe later"
            android:textColor="#4DA8FF"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>
